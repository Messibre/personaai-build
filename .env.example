# LLM Configuration
LLM_PROVIDER=gemini # or mock
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=10000
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Vault storage.
# Local dev: files under VAULT_DATA_DIR (not used on Vercel).
VAULT_DATA_DIR=data/vaults
# Production (Vercel): persistent storage via Upstash Redis. Create a free database at
# https://console.upstash.com (Redis > Create database), open the "REST API" section, and copy
# the URL (https://<name>.upstash.io) and the read-write token. Without both, /api/vault returns 501 on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub (optional). Unauthenticated GitHub allows only 60 requests/hour per IP;
# a token raises that to 5,000. Used as an Authorization: Bearer header for repo imports.
GITHUB_TOKEN=

# Admin metrics page (/admin) and GET /api/admin/metrics. Leave unset to keep them closed (503).
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=

# Closed-beta gate for the Gemini-backed routes (import, questions, tailor).
# Clients send it as the x-beta-code header. Leave unset or empty to keep the routes open (local dev).
# Generate one with: openssl rand -base64 24
BETA_ACCESS_CODE=
