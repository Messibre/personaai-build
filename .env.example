# LLM Configuration
LLM_PROVIDER=gemini # or mock
GEMINI_MODEL=gemini-2.5-flash
# Per-call model timeout. Structured job analysis and draft writing routinely take 10-25s on
# gemini-2.5-flash; 10s caused false "unavailable" results, so 30s is the default.
LLM_TIMEOUT_MS=30000
# Quick fit check (/job-match): set to "true" to let Gemini refine the deterministic report.
# Uses the legacy lib/gemini.ts client. Leave unset or "false" for rules-only reports.
AI_ENHANCE=false
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Vault storage.
# Local dev: files under VAULT_DATA_DIR (not used on Vercel).
VAULT_DATA_DIR=data/vaults
# Production (Vercel): persistent storage via Upstash Redis. Create a free database at
# https://console.upstash.com (Redis > Create database), open the "REST API" section, and copy
# the URL (https://<name>.upstash.io) and the read-write token. Without both, /api/vault returns 501 on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub. REQUIRED for /job-match (Quick fit check): it uses the GitHub GraphQL API, which
# rejects unauthenticated requests. Optional for vault imports, where it raises the REST limit
# from 60 to 5,000 requests/hour. Sent as an Authorization: Bearer header.
GITHUB_TOKEN=

# Admin metrics page (/admin) and GET /api/admin/metrics. Leave unset to keep them closed (503).
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=

# Closed-beta gate for the Gemini-backed routes (import, questions, tailor).
# Clients send it as the x-beta-code header. Leave unset or empty to keep the routes open (local dev).
# Generate one with: openssl rand -base64 24
BETA_ACCESS_CODE=

# Legacy generator (/legacy) one-click deploy. /api/deploy returns 404 unless this is "true",
# because it spends VERCEL_TOKEN on behalf of anonymous visitors.
ENABLE_LEGACY_DEPLOY=false
# Legacy only: Vercel token and optional team id used by /api/deploy.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
